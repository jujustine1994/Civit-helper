{
  "manifest_version": 3,
  "name": "Civit Helper",
  "version": "0.2.0",
  "description": "連接本機 Civit Helper，僅操作工具建立的 Civitai 分頁。",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage", "alarms", "webRequest"],
  "host_permissions": ["https://civitai.red/*", "http://127.0.0.1:43187/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Civit Helper"}
}
